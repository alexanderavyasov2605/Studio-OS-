{
  "name": "studio-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:routes": "node tests/run-routes.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:test": "prisma generate && tsx tests/database.integration.ts"
  },
  "dependencies": {
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.23.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "tailwindcss": "4.3.4",
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "prisma": "7.10.1",
    "dotenv": "^17.2.0",
    "vitest": "5.1.0",
    "tsx": "4.23.15"
  }
}
