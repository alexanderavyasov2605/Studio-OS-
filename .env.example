# Page shells, dev, unit tests, client generation and build need no database.
# For migration and seed use the single Supabase PostgreSQL.
# Copy the real direct/session connection URL from your Supabase project into .env.
# Never prefix database credentials with NEXT_PUBLIC_.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Optional migration connection (direct or Supabase session pooler, port 5432).
# DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Optional: a dedicated EMPTY disposable PostgreSQL database for pnpm db:test.
# Tests refuse non-empty databases and never reset or drop an existing database.
# DATABASE_TEST_URL="postgresql://TEST_USER:TEST_PASSWORD@localhost:5432/studio_os_test"

# Telegram Login / OIDC: BotFather -> @StudiaOSBot -> Login Widget.
# Never use NEXT_PUBLIC_ for secrets. This is NOT the Bot API token.
# Register APP_ORIGIN and APP_ORIGIN/api/auth/telegram/callback as Allowed URLs.
TELEGRAM_CLIENT_ID="9297780783"
TELEGRAM_CLIENT_SECRET=""
# Explicitly authorized owner; checked only against the verified Telegram ID claim.
TELEGRAM_ADMIN_ID="930826522"

# Exact browser origin. Production requires HTTPS; no URL credentials/path/query.
APP_ORIGIN="http://localhost:3000"

# Bootstrap only: provide ADMIN_EMAIL and ADMIN_PASSWORD through a secure environment.
# There is intentionally no default password. Remove them after admin:bootstrap.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
